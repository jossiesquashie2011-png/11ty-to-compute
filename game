<!DOCTYPE html><html>
<head>
  <meta charset="UTF-8">
  <title>Funny Shooter 3D - Enhanced Web Version</title>
  <style>
    body,html { margin:0; padding:0; overflow:hidden; font-family: Arial; }
    #menu {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      background: #111; color: white; display: flex; flex-direction: column;
      align-items: center; justify-content: center; z-index: 10;
    }
    #menu button {
      padding: 15px 30px; margin-top: 20px; font-size: 20px; cursor: pointer;
      background: #ff6600; border: none; border-radius: 10px;
    }
    canvas { width:100%; height:100%; display:block; }
  </style>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r150/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.150/examples/js/controls/PointerLockControls.js"></script>
</head>
<body><!-- Main Menu --><div id="menu">
  <h1>Funny Shooter 3D</h1>
  <button onclick="startGame()">Play</button>
</div><script>
// === Core Setup ===
let started = false;
const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(75, window.innerWidth/window.innerHeight, 0.1, 1000);
const renderer = new THREE.WebGLRenderer();
renderer.setSize(window.innerWidth, window.innerHeight);
document.body.appendChild(renderer.domElement);

// Lighting
scene.add(new THREE.AmbientLight(0xffffff, 0.5));
const sun = new THREE.DirectionalLight(0xffffff, 1);
sun.position.set(10,20,10);
scene.add(sun);

// Controls
gravity = new THREE.Vector3(0, -0.004, 0);
const controls = new THREE.PointerLockControls(camera, document.body);

// Player movement vars
let velocity = new THREE.Vector3(), keys = {}, canJump = true;
document.addEventListener('keydown', e => keys[e.code] = true);
document.addEventListener('keyup', e => keys[e.code] = false);

// Ground
const ground = new THREE.Mesh(
  new THREE.PlaneGeometry(300,300),
  new THREE.MeshLambertMaterial({color:0x55aa55})
);
ground.rotation.x = -Math.PI/2;
ground.receiveShadow = true;
scene.add(ground);

// Gun model
let gun;
function createGun() {
  const g = new THREE.Mesh(
    new THREE.BoxGeometry(0.4,0.2,1.2),
    new THREE.MeshLambertMaterial({color:0x2222ff})
  );
  g.position.set(0.4, -0.4, -1);
  g.castShadow = true;
  camera.add(g);
  gun = g;
}

// Sound Effects
let shootSound = new Audio('https://actions.google.com/sounds/v1/ambiences/laser_1.ogg');
let hitSound = new Audio('https://actions.google.com/sounds/v1/cartoon/clang_and_wobble.ogg');

// Enemies
let enemies = [];
function createEnemy() {
  const geo = new THREE.BoxGeometry(1,1,1);
  const mat = new THREE.MeshLambertMaterial({color:Math.random()*0xffffff});
  const e = new THREE.Mesh(geo,mat);
  e.position.set((Math.random()*150)-75, 1, (Math.random()*150)-75);
  e.health = 3;
  scene.add(e);
  enemies.push(e);
}

// Wave System
let wave = 1;
function spawnWave() {
  for (let i = 0; i < wave * 5; i++) createEnemy();
}

// Shooting
window.addEventListener('mousedown', () => {
  if (!started) return;
  shootSound.play();
  shoot();
});

function shoot() {
  const ray = new THREE.Raycaster(camera.position, camera.getWorldDirection(new THREE.Vector3()));
  const hits = ray.intersectObjects(enemies);
  if (hits.length > 0) {
    const hit = hits[0].object;
    hit.health--;
    hit.material.color.set(0xff0000);
    hitSound.play();
    if (hit.health <= 0) {
      scene.remove(hit);
      enemies = enemies.filter(e => e !== hit);
      if (enemies.length === 0) {
        wave++;
        spawnWave();
      }
    }
  }
}

// Menu Start
function startGame() {
  document.getElementById('menu').style.display = 'none';
  controls.lock();
  started = true;
  createGun();
  spawnWave();
}

// Game Loop
function animate() {
  requestAnimationFrame(animate);

  if (controls.isLocked) {
    const speed = 0.12;

    let dir = new THREE.Vector3();

    if (keys['KeyW']) dir.z -= speed;
    if (keys['KeyS']) dir.z += speed;
    if (keys['KeyA']) dir.x -= speed;
    if (keys['KeyD']) dir.x += speed;

    controls.moveRight(dir.x);
    controls.moveForward(dir.z);
  }

  // Enemies move toward player
  enemies.forEach(e => {
    const d = new THREE.Vector3().subVectors(camera.position, e.position).normalize();
    e.position.addScaledVector(d, 0.03);
  });

  renderer.render(scene, camera);
}
animate();

// Resize
window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

</script></body>
</html><!DOCTYPE html>
